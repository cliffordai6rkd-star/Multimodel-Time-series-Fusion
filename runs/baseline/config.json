{
  "seed": 42,
  "data": {
    "data_dir": "data",
    "class_names": [
      "cloth",
      "leather",
      "metal",
      "wood"
    ],
    "sequence_length": 1024,
    "signal_normalize": "per_sample",
    "image_size": 224,
    "image_line_width": 1,
    "image_normalize": true,
    "val_ratio": 0.2,
    "num_workers": 0
  },
  "model": {
    "num_classes": 4,
    "time_encoder": {
      "input_channels": 2,
      "stem_channels": 32,
      "stem_kernel_size": 7,
      "stem_stride": 2,
      "block_channels": [
        64,
        128,
        256
      ],
      "block_strides": [
        2,
        2,
        2
      ],
      "block_kernel_size": 3,
      "feature_dim": 128,
      "dropout": 0.2,
      "use_batch_norm": true
    },
    "image_encoder": {
      "input_channels": 3,
      "channels": [
        32,
        64,
        128,
        128
      ],
      "kernel_size": 3,
      "pool_every": [
        true,
        true,
        true,
        false
      ],
      "feature_dim": 128,
      "dropout": 0.2,
      "use_batch_norm": true
    },
    "fusion": {
      "hidden_dims": [
        128,
        64
      ],
      "dropouts": [
        0.3,
        0.2
      ]
    }
  },
  "train": {
    "epochs": 1,
    "batch_size": 8,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "device": "cpu",
    "save_dir": "runs/baseline",
    "print_every": 1
  }
}